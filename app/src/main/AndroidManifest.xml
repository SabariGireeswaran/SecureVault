<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        SECURITY: The ONLY permission is fingerprint.
        There is NO INTERNET permission, so this app physically cannot send your photos anywhere.
        There is NO storage permission: photos are picked through Android's own picker.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".VaultApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/VaultTheme">

        <activity
            android:name=".ui.LockActivity"
            android:exported="true"
            android:theme="@style/VaultTheme.NoBar"
            android:windowSoftInputMode="stateVisible|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.VaultActivity" android:exported="false" />

        <activity
            android:name=".ui.ViewerActivity"
            android:exported="false"
            android:theme="@style/VaultTheme.NoBar" />
    </application>
</manifest>

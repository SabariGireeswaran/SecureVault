<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        SECURITY: The ONLY permission is fingerprint.
        There is NO INTERNET permission, so this app physically cannot send your photos anywhere.
        There is NO storage permission: photos are picked through Android's own picker.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".VaultApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/VaultTheme">

        <!-- The real first screen. It has no launcher icon itself; one of the two aliases below opens it. -->
        <activity
            android:name=".ui.LockActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- DISGUISE MODE: exactly ONE of these two is enabled at a time (see ui/Disguise.java). -->
        <activity-alias
            android:name=".LauncherDefault"
            android:targetActivity=".ui.LockActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherCalculator"
            android:targetActivity=".ui.LockActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_calc"
            android:roundIcon="@mipmap/ic_launcher_calc"
            android:label="@string/disguise_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity android:name=".ui.VaultActivity" android:exported="false" />
        <activity android:name=".ui.ViewerActivity" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
    </application>
</manifest>
